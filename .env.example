# ──────────────────────────────────────────────────────────────────────────────
# Environment variables — copy to .env and fill real values.
# NEVER commit a .env with real secrets.
# ──────────────────────────────────────────────────────────────────────────────

# Database
DATABASE_URL=postgresql+asyncpg://cpi_user:CHANGEME@db:5432/cpi_db
DATABASE_URL_SYNC=postgresql://cpi_user:CHANGEME@db:5432/cpi_db

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=CHANGEME_at_least_32_chars_long
JWT_REFRESH_SECRET=CHANGEME_refresh_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend
API_BASE_URL=http://localhost:8000
FRONTEND_API_URL=http://localhost:5173

# App
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Analytics constants (document — do not change without changelog entry)
MEAL_WEIGHT_KG=0.5
MEALS_PER_BENEFICIARY_PER_PERIOD=14
